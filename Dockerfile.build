FROM golang:1.21 AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    git \
    make \
    gcc \
    g++ \
    zip \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy go.mod and go.sum files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy the source code
COPY . .

# Build for multiple platforms
RUN mkdir -p /dist

# Linux (amd64)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /dist/theo-linux-amd64 ./cmd/theo

# Linux (arm64)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -ldflags="-s -w" -o /dist/theo-linux-arm64 ./cmd/theo

# macOS (amd64)
RUN CGO_ENABLED=0 GOOS=darwin GOARCH=amd64 go build -ldflags="-s -w" -o /dist/theo-darwin-amd64 ./cmd/theo

# macOS (arm64)
RUN CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -ldflags="-s -w" -o /dist/theo-darwin-arm64 ./cmd/theo

# Windows (amd64)
RUN CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -ldflags="-s -w" -o /dist/theo-windows-amd64.exe ./cmd/theo

# Create zip archives
WORKDIR /dist
RUN zip -9 theo-linux-amd64.zip theo-linux-amd64
RUN zip -9 theo-linux-arm64.zip theo-linux-arm64
RUN zip -9 theo-darwin-amd64.zip theo-darwin-amd64
RUN zip -9 theo-darwin-arm64.zip theo-darwin-arm64
RUN zip -9 theo-windows-amd64.zip theo-windows-amd64.exe

# Final stage
FROM alpine:latest

# Install dependencies
RUN apk add --no-cache ca-certificates

# Copy the binaries from the builder stage
COPY --from=builder /dist /dist

# Set the working directory
WORKDIR /dist

# Set the entrypoint
ENTRYPOINT ["/bin/sh"]