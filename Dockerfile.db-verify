FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    sqlite3 \
    jq \
    python3 \
    python3-pip \
    iputils-ping \
    net-tools \
    netcat \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Make scripts executable
RUN chmod +x /app/scripts/db-verify/run_db_verify.sh || true

# Default command
CMD ["/app/scripts/db-verify/run_db_verify.sh"]
