FROM golang:1.18-alpine

# Install build dependencies
RUN apk add --no-cache git make gcc libc-dev

# Set working directory
WORKDIR /app

# We'll mount the source code as a volume, so we don't need to copy it here
# This allows for faster test iterations during development

# Set the entrypoint to go test
ENTRYPOINT ["go", "test"]

# Default command runs all tests with verbose output
CMD ["./...", "-v"]